<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Product>BenchWarpFix</Product>
    <RootNamespace>BenchWarpFix</RootNamespace>
    <AssemblyName>BenchWarpFix</AssemblyName>
    <AssemblyTitle>BenchWarpFix</AssemblyTitle>
    <Description>A Hollow Knight Mod</Description>
    <Copyright>Copyright © SFGrenade 2025</Copyright>
    <AssemblyVersion>1.5.1.3</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <InformationalVersion>1.5.1.3汉化</InformationalVersion>
    <ImplicitUsings>false</ImplicitUsings>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <OutputPath>bin/$(Configuration)/</OutputPath>
    <LangVersion>latest</LangVersion>
    <PathMap>$(MSBuildProjectDirectory)=source</PathMap>
    <HollowKnightRefs>$(HkRefs)</HollowKnightRefs>
    <ExportDir>bin/Publish</ExportDir>
    <!--<GenerateDocumentationFile>true</GenerateDocumentationFile>-->
  </PropertyGroup>
  <Import Project="LocalOverrides.targets" Condition="Exists('LocalOverrides.targets')" />
  <Import Project="build_steps.targets" />
  <!-- 用户决策(2026-09-11)：关闭强名称签名，保持与原版 DLL（未签名）一致 -->
  <PropertyGroup>
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(HollowKnightRefs)/*.dll" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Resources" />
    <Folder Include="src" />
    <Folder Include="test" />
    <None Include=".gitignore" />
    <None Include="LICENSE" />
    <None Include="ModDependencies.txt" />
    <None Include="README.md" />
  </ItemGroup>
</Project>
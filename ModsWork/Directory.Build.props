<Project>
  <!--
    统一参考路径：只读指向游戏 Managed 目录。
    绝不向该目录写入任何内容（各工程 csproj 的 CopyMod 目标均已 Condition=false）。
  -->
  <PropertyGroup>
    <HkRefs>E:\steam\steamapps\common\Hollow Knight\hollow_knight_Data\Managed</HkRefs>
    <HKRefs>$(HkRefs)</HKRefs>
    <HollowKnightRefs>$(HkRefs)</HollowKnightRefs>
    <LocalRefs>$(HkRefs)</LocalRefs>
    <VanillaFiles>$(HkRefs)</VanillaFiles>
    <ModdingAPI>$(HkRefs)</ModdingAPI>
    <ModdingApi>$(HkRefs)</ModdingApi>
  </PropertyGroup>
</Project>

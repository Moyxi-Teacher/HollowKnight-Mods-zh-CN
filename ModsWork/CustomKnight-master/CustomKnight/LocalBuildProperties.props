<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    本次（2026-09-18）构建的本地引用配置。
    工作副本位于 D:\重要文件\Downloads\temp\repo3（临时目录）。

    1. 参考 DLL 全部指向游戏的 Managed 目录 —— **只读引用，绝不写入**。
    2. HollowKnightModsDirectory 保持指向 D:\KDQSHH\Mods（D 盘），
       使 csproj 中的 PostBuild 复制目标不会写进 E 盘游戏目录。
  -->
  <PropertyGroup>
    <HkRefs>E:\steam\steamapps\common\Hollow Knight\hollow_knight_Data\Managed</HkRefs>
    <HKRefs>$(HkRefs)</HKRefs>
    <HKRefsFolder>$(HkRefs)</HKRefsFolder>
    <VanillaFiles>$(HkRefs)</VanillaFiles>
    <ModdingAPI>$(HkRefs)</ModdingAPI>
    <ModdingAPi>$(HkRefs)</ModdingAPi>
    <HKModdingApi>$(HkRefs)</HKModdingApi>
    <LocalRefs>$(HkRefs)</LocalRefs>
    <References>$(HkRefs)</References>
    <HollowKnightRefs>$(HkRefs)</HollowKnightRefs>
    <HollowKnightManagedFolder>$(HkRefs)</HollowKnightManagedFolder>
    <SatchelDirectory>$(HkRefs)\Mods\Satchel（依赖库）</SatchelDirectory>
    <CustomKnightReference>$(HkRefs)\Mods\CustomKnight（自定义小骑士）</CustomKnightReference>

    <!-- 产物输出：一律 D 盘，绝不写入游戏目录 -->
    <HollowKnightModsDirectory>D:\KDQSHH\Mods\_构建输出</HollowKnightModsDirectory>
  </PropertyGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);OLD_HK_VERSION_HAVE_FALSE_WHEN_MAPI_UPDATED</DefineConstants>
    <TargetFramework>net472</TargetFramework>
    <Product>SFCore</Product>
    <RootNamespace>SFCore</RootNamespace>
    <AssemblyName>SFCore</AssemblyName>
    <AssemblyTitle>SFCore</AssemblyTitle>
    <Description>A Hollow Knight Mod Library</Description>
    <Copyright>Copyright © SFGrenade 2025</Copyright>
    <AssemblyVersion>1.5.14.8</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <InformationalVersion>1.5.14.8汉化</InformationalVersion>
    <ImplicitUsings>false</ImplicitUsings>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <OutputPath>bin/$(Configuration)/</OutputPath>
    <LangVersion>latest</LangVersion>
    <PathMap>$(MSBuildProjectDirectory)=source</PathMap>
    <HollowKnightRefs>../HkRefs</HollowKnightRefs>
    <ExportDir>bin/Publish</ExportDir>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <Import Project="LocalOverrides.targets" Condition="Exists('LocalOverrides.targets')" />
  <Import Project="build_steps.targets" />
  <!-- 按用户决策：关闭强名称签名，保持与原版 DLL（PublicKeyToken=null）一致 -->
  <PropertyGroup>
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(HollowKnightRefs)/*.dll" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Resources" />
    <Folder Include="src" />
    <Folder Include="test" />
    <None Include=".gitignore" />
    <None Include="LICENSE" />
    <None Include="ModDependencies.txt" />
    <None Include="README.md" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/Language.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WavLib" Version="1.*" />
  </ItemGroup>
</Project>

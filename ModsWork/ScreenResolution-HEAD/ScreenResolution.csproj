<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <Product>ScreenResolution</Product>
        <RootNamespace>ScreenResolution</RootNamespace>
        <AssemblyName>ScreenResolution</AssemblyName>
        <AssemblyTitle>ScreenResolution</AssemblyTitle>
        <Description>A Mod Library</Description>
        <Copyright>Copyright © SFGrenade 2025</Copyright>
        <AssemblyVersion>1.5.0.0</AssemblyVersion>
    <InformationalVersion>1.5.0.0汉化</InformationalVersion>
        <FileVersion>$(AssemblyVersion)</FileVersion>
        <ImplicitUsings>false</ImplicitUsings>
        <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
        <OutputPath>bin/$(Configuration)/</OutputPath>
        <LangVersion>12</LangVersion>
        <PathMap>$(MSBuildProjectDirectory)=source</PathMap>
        <HollowKnightRefs>../HkRefs</HollowKnightRefs>
        <ExportDir>bin/Publish</ExportDir>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
    <Import Project="LocalOverrides.targets" Condition="Exists('LocalOverrides.targets')"/>
    <Import Project="build_steps.targets" Condition="false"/>
    <!-- 用户决策(2026-09-11)：关闭强名称签名，保持与原版 DLL（未签名）一致 -->
    <PropertyGroup>
        <SignAssembly>false</SignAssembly>
    </PropertyGroup>
    <ItemGroup>
        <Reference Include="$(HollowKnightRefs)/*.dll" />
        <Reference Include="$(HollowKnightRefs)/Mods/Satchel/Satchel.dll" />
        <Reference Condition="!Exists('../SFCore/SFCore.csproj')" Include="$(HollowKnightRefs)/Mods/SFCore/SFCore.dll" />
    </ItemGroup>
    <ItemGroup>
        <Folder Include="Resources"/>
        <Folder Include="src"/>
        <Folder Include="test"/>
        <None Include=".gitignore"/>
        <None Include="LICENSE"/>
        <None Include="ModDependencies.txt"/>
        <None Include="README.md"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Condition="Exists('../SFCore/SFCore.csproj')" Include="../SFCore/SFCore.csproj" />
    </ItemGroup>
</Project>
